# Runtime artifacts produced while the tools work
__pycache__/
*.pyc

# reports written next to the current working directory
report-data.csv
report-*.csv
report-*.json
report-*.xlsx
cleanup-report.csv

# the GUI's own settings file, kept next to the home directory, never in the repo
.scan_backdoors_gui.json

# the GUI's whitelist: it lives in the data folder now, this only catches an old copy
# (or one written next to the scanner by a previous version)
src/whitelist.txt

# the tools' data folder, if someone points SBD_DATA_DIR inside the repo
.scan_backdoors/

# the local Joomla baseline cache written by joomla_baseline.py
joomla-baselines/
*.baseline.json

# quarantine created next to a scanned site, and the copies it keeps
_quarantine_*/
*.modified

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# measurement artifacts of the development tools (CI installs them; nothing here is
# part of the bundle). tests/test_release.py walks the working tree, so a leftover
# data file must be ignored rather than trusted to nobody running the linter locally
.coverage
.coverage.*
htmlcov/
coverage.xml
benchmarks/*-local.json

# never commit real client material: audits, dumps, ACL backups
*_audit.csv
*-audit.csv
acl-backup-*
acl-report-*
