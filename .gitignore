# Runtime artifacts produced while the tools work
__pycache__/
*.pyc

# reports written next to the current working directory
report-data.csv
report-*.csv
report-*.json
report-*.xlsx
cleanup-report.csv

# the GUI's own settings file, kept next to the home directory, never in the repo
.scan_backdoors_gui.json

# whitelist the GUI writes by default (next to scan_backdoors.py)
src/whitelist.txt

# the local Joomla baseline cache written by joomla_baseline.py
joomla-baselines/
*.baseline.json

# quarantine created next to a scanned site, and the copies it keeps
_quarantine_*/
*.modified

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# never commit real client material: audits, dumps, ACL backups
*_audit.csv
*-audit.csv
acl-backup-*
acl-report-*
